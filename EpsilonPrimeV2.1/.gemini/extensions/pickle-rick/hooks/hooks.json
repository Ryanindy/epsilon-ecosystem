{
  "hooks": {
    "BeforeAgent": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "increment-iteration",
            "type": "command",
            "command": "cmd /c \"${extensionPath}/dispatch.bat\" increment-iteration",
            "description": "Increments the iteration"
          },
          {
            "name": "reinforce-pickle-persona",
            "type": "command",
            "command": "cmd /c \"${extensionPath}/dispatch.bat\" reinforce-persona",
            "description": "Injects persona directives"
          }
        ]
      }
    ],
    "BeforeModel": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "check-limit",
            "type": "command",
            "command": "cmd /c \"${extensionPath}/dispatch.bat\" check-limit",
            "description": "Checks limit"
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "pickle-sentinel-indexer",
            "type": "command",
            "command": "cmd /c \"${extensionPath}/auto_indexer.bat\"",
            "description": "Automatically updates the Skill Router when files change"
          },
          {
            "name": "pickle-rick-loop",
            "type": "command",
            "command": "cmd /c \"${extensionPath}/dispatch.bat\" stop-hook",
            "description": "Loop control"
          }
        ]
      }
    ]
  }
}
